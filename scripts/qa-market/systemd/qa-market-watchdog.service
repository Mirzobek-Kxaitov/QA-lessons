[Unit]
Description=QA market independent refresh watchdog
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
EnvironmentFile=/etc/qa-market-watchdog.env
ExecStart=/usr/bin/python3 /opt/qa-market-watchdog/vps_watchdog.py
TimeoutStartSec=120
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=128M
CPUQuota=20%
